# Copy to .env (development) or .env.test and fill in. Placeholders only; never commit real values.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Comma-separated list of allowed browser origins. Empty = no cross-origin access.
CORS_ORIGINS=http://localhost:3001

# Reverse proxies in front of the app whose X-Forwarded-For is trusted (0 = none, 1 = one load balancer).
# Must match your deployment or rate limiting sees the wrong client IP.
TRUST_PROXY=0

# Swagger UI at /api/docs. Keep false in production unless protected.
SWAGGER_ENABLED=true

# Global rate limit (requests per window)
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100

# PostgreSQL (matches docker/docker-compose.yml)
DATABASE_URL=postgresql://temelash:change_me@localhost:5432/temelashcard?schema=public

# Auth
JWT_ACCESS_SECRET=replace_with_long_random_string_min_32_chars
JWT_ISSUER=temelashcard
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Strict limit per IP+email on POST /auth/login
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_TTL_SECONDS=60

# Public customer enrollment (POST /join/:ref/enroll): per-IP budget
ENROLL_RATE_LIMIT_MAX=10
ENROLL_RATE_LIMIT_TTL_SECONDS=60

# ── Wallet passes ──────────────────────────────────────────────────────────────
# fake = in-memory adapters, no credentials needed (development and tests). live = real Apple/Google.
WALLET_MODE=fake
WALLET_APPLE_ENABLED=false
WALLET_GOOGLE_ENABLED=false
# Public https URL of this API (used in pass download links and the Apple web service URL)
WALLET_PUBLIC_BASE_URL=http://localhost:3000
# Required when a provider is enabled. Long random value; changing it invalidates issued wallet barcodes.
WALLET_BARCODE_SECRET=

# Apple Wallet (live mode). Paths point to files OUTSIDE the repository; never commit them.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_ORGANIZATION_NAME=TemelashCard
APPLE_PASS_CERT_PATH=
APPLE_PASS_KEY_PATH=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT_PATH=
APPLE_APNS_HOST=api.push.apple.com

# Google Wallet (live mode). demo = test users only, production = approved issuer.
GOOGLE_WALLET_ENV=demo
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_WALLET_ORIGINS=
GOOGLE_WALLET_DEFAULT_LOGO_URL=

# Background jobs: the outbox worker delivers wallet updates after the stamp has been saved
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=10

# Scanner: minimum seconds between two stamps for one card, even if the program cooldown is 0
SCANNER_MIN_INTERVAL_SECONDS=10
# How long idempotent scanner responses are kept for replay
IDEMPOTENCY_TTL_HOURS=48

# Periodic jobs: fraud evaluation and data retention (de-duplicated, safe with many instances)
SCHEDULER_ENABLED=true
FRAUD_EVALUATION_INTERVAL_MINUTES=15
RETENTION_INTERVAL_HOURS=24
