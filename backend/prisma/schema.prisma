// TemelashCard schema. See docs/data-model.md for relationships and invariants.
//
// Conventions
//  - UUID primary keys generated by PostgreSQL (gen_random_uuid()).
//  - All timestamps are timestamptz (UTC instants).
//  - Every merchant-owned table has merchant_id. Child tables reference parents through
//    COMPOSITE foreign keys that include merchant_id, so a row can never point at another
//    tenant's parent.
//  - Foreign keys never cascade: history survives deactivation. Deactivation is a status.
//  - Append-only tables (stamp/redemption/reversal/audit/consent events) are protected by
//    database triggers (see the migration that adds them).
//  - NO payment, revenue, order-value, invoice or billing data is stored anywhere.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum AccountType {
  PLATFORM_ADMIN
  MERCHANT_USER

  @@map("account_type")
}

enum AccountStatus {
  ACTIVE
  DEACTIVATED

  @@map("account_status")
}

enum Language {
  EN
  AM

  @@map("language")
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("merchant_status")
}

enum BranchStatus {
  ACTIVE
  INACTIVE

  @@map("branch_status")
}

enum StaffStatus {
  INVITED
  ACTIVE
  DEACTIVATED

  @@map("staff_status")
}

enum RoleScope {
  PLATFORM
  MERCHANT

  @@map("role_scope")
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED

  @@map("program_status")
}

enum RewardDefinitionStatus {
  ACTIVE
  ARCHIVED

  @@map("reward_definition_status")
}

enum CustomerStatus {
  ACTIVE
  ANONYMIZED

  @@map("customer_status")
}

enum ConsentType {
  LOYALTY_TERMS
  MARKETING

  @@map("consent_type")
}

enum ConsentAction {
  GRANTED
  WITHDRAWN

  @@map("consent_action")
}

enum ConsentSource {
  JOIN_FORM
  STAFF_ASSISTED
  PRIVACY_REQUEST
  IMPORT

  @@map("consent_source")
}

enum MembershipStatus {
  ACTIVE
  INACTIVE

  @@map("membership_status")
}

enum WalletProvider {
  APPLE
  GOOGLE
  WEB

  @@map("wallet_provider")
}

enum WalletPassStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INVALIDATED

  @@map("wallet_pass_status")
}

enum WalletSyncStatus {
  PENDING
  SYNCED
  FAILED

  @@map("wallet_sync_status")
}

enum ReversalTarget {
  STAMP
  REDEMPTION

  @@map("reversal_target")
}

enum AuditActorType {
  USER
  SYSTEM

  @@map("audit_actor_type")
}

enum FraudIndicator {
  EXCESSIVE_STAMPS_BY_STAFF
  REPEATED_SCANS_FOR_MEMBERSHIP
  UNUSUAL_BRANCH_ACTIVITY
  HIGH_REVERSAL_RATE
  REPEATED_COOLDOWN_REJECTIONS
  EXCESSIVE_REDEMPTIONS

  @@map("fraud_indicator")
}

enum FraudSubjectType {
  STAFF
  MEMBERSHIP
  BRANCH

  @@map("fraud_subject_type")
}

enum FraudFlagStatus {
  OPEN
  DISMISSED
  CONFIRMED

  @@map("fraud_flag_status")
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD

  @@map("outbox_status")
}

// ─────────────────────────── Identity & access ───────────────────────────

/// A login account. PLATFORM_ADMIN accounts never have a staff membership;
/// MERCHANT_USER accounts act only through staff memberships.
model PlatformUser {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String        @unique
  passwordHash      String        @map("password_hash")
  displayName       String        @map("display_name")
  accountType       AccountType   @map("account_type")
  status            AccountStatus @default(ACTIVE)
  preferredLanguage Language      @default(EN) @map("preferred_language")
  lastLoginAt       DateTime?     @map("last_login_at") @db.Timestamptz(3)
  /// Consecutive failed logins; reset on success. Drives temporary lockout.
  failedLoginCount  Int           @default(0) @map("failed_login_count")
  lockedUntil       DateTime?     @map("locked_until") @db.Timestamptz(3)
  deactivatedAt     DateTime?     @map("deactivated_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  staffMemberships   StaffMembership[]
  auditEvents        AuditEvent[]
  refreshTokens      RefreshToken[]
  reviewedFraudFlags FraudFlag[]

  @@map("platform_users")
}

/// Rotating refresh token. Only a SHA-256 hash is stored. One chain of rotations shares a family_id;
/// presenting an already-rotated token revokes the whole family (theft detection).
model RefreshToken {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  familyId          String    @map("family_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  deviceLabel       String?   @map("device_label")
  userAgent         String?   @map("user_agent")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// ROTATED | LOGOUT | LOGOUT_ALL | REUSE_DETECTED | ACCOUNT_DEACTIVATED | ROLE_CHANGED
  revokedReason     String?   @map("revoked_reason")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Global (non-tenant) catalog of roles: PLATFORM_ADMIN, OWNER, MANAGER, STAFF.
model Role {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String    @unique
  name        String
  scope       RoleScope
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  permissions      RolePermission[]
  staffMemberships StaffMembership[]

  @@map("roles")
}

/// Global catalog of permission keys, e.g. "stamp:create".
model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ───────────────────────────── Merchants ─────────────────────────────

model Merchant {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String         @unique
  nameEn          String         @map("name_en")
  nameAm          String?        @map("name_am")
  status          MerchantStatus @default(ACTIVE)
  timezone        String         @default("Africa/Addis_Ababa")
  defaultLanguage Language       @default(EN) @map("default_language")
  /// Public, merchant-specific reference used in join links / QR codes.
  joinReference   String         @unique @map("join_reference")
  deactivatedAt   DateTime?      @map("deactivated_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  settings           MerchantSettings?
  branches           Branch[]
  staffMemberships   StaffMembership[]
  customers          Customer[]
  programs           LoyaltyProgram[]
  auditEvents        AuditEvent[]
  outboxJobs         OutboxJob[]
  idempotencyRecords IdempotencyRecord[]
  fraudFlags         FraudFlag[]

  @@map("merchants")
}

model MerchantSettings {
  merchantId String @id @map("merchant_id") @db.Uuid

  supportEmail           String?  @map("support_email")
  supportPhoneE164       String?  @map("support_phone_e164")
  /// Upload-ready logo metadata only; file storage is not implemented yet.
  logoStorageKey         String?  @map("logo_storage_key")
  logoContentType        String?  @map("logo_content_type")
  defaultStampsRequired  Int      @default(10) @map("default_stamps_required")
  defaultCooldownMinutes Int      @default(0) @map("default_cooldown_minutes")
  /// Fraud-flag thresholds (flagging only). Validated by the application.
  fraudThresholds        Json     @default("{}") @map("fraud_thresholds")
  /// Retention periods in days. Validated by the application.
  retentionPolicy        Json     @default("{}") @map("retention_policy")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@map("merchant_settings")
}

model Branch {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId    String       @map("merchant_id") @db.Uuid
  nameEn        String       @map("name_en")
  nameAm        String?      @map("name_am")
  addressText   String?      @map("address_text")
  city          String?
  phoneE164     String?      @map("phone_e164")
  status        BranchStatus @default(ACTIVE)
  deactivatedAt DateTime?    @map("deactivated_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  staffAssignments StaffBranchAssignment[]
  stampEvents      StampEvent[]
  redemptionEvents RedemptionEvent[]
  auditEvents      AuditEvent[]

  @@unique([id, merchantId])
  @@index([merchantId, status])
  @@map("branches")
}

/// A user's role inside one merchant. Deactivated, never deleted: ledger rows reference it.
model StaffMembership {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId    String      @map("merchant_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  roleId        String      @map("role_id") @db.Uuid
  status        StaffStatus @default(INVITED)
  invitedAt     DateTime    @default(now()) @map("invited_at") @db.Timestamptz(3)
  activatedAt   DateTime?   @map("activated_at") @db.Timestamptz(3)
  deactivatedAt DateTime?   @map("deactivated_at") @db.Timestamptz(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant     @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  user     PlatformUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  role     Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  branchAssignments  StaffBranchAssignment[]
  stampEvents        StampEvent[]
  redemptionEvents   RedemptionEvent[]
  reversalEvents     ReversalEvent[]
  idempotencyRecords IdempotencyRecord[]
  invitations        StaffInvitation[]

  @@unique([merchantId, userId])
  @@unique([id, merchantId])
  @@index([merchantId, status])
  @@map("staff_memberships")
}

/// Single-use invitation for a staff membership in INVITED status. Only a hash of the token is stored.
model StaffInvitation {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId        String    @map("merchant_id") @db.Uuid
  staffMembershipId String    @map("staff_membership_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  invitedByUserId   String    @map("invited_by_user_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt        DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  staffMembership StaffMembership @relation(fields: [staffMembershipId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@index([merchantId, staffMembershipId])
  @@map("staff_invitations")
}

model StaffBranchAssignment {
  staffMembershipId String   @map("staff_membership_id") @db.Uuid
  branchId          String   @map("branch_id") @db.Uuid
  merchantId        String   @map("merchant_id") @db.Uuid
  assignedAt        DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  staffMembership StaffMembership @relation(fields: [staffMembershipId, merchantId], references: [id, merchantId], onDelete: Restrict)
  branch          Branch          @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@id([staffMembershipId, branchId])
  @@index([merchantId, branchId])
  @@map("staff_branch_assignments")
}

// ───────────────────────────── Customers ─────────────────────────────

/// A customer record exists per merchant. The same person at two merchants is two rows.
model Customer {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId        String         @map("merchant_id") @db.Uuid
  /// Normalized E.164 (+251XXXXXXXXX). NULL after anonymization.
  phoneE164         String?        @map("phone_e164")
  firstName         String?        @map("first_name")
  preferredLanguage Language       @default(EN) @map("preferred_language")
  status            CustomerStatus @default(ACTIVE)
  anonymizedAt      DateTime?      @map("anonymized_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  consents    CustomerConsent[]
  memberships CustomerMembership[]

  @@unique([merchantId, phoneE164])
  @@unique([id, merchantId])
  @@index([merchantId, firstName])
  @@index([merchantId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("customers")
}

/// Append-only consent history. Current consent = latest row per (customer, type).
model CustomerConsent {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId String        @map("merchant_id") @db.Uuid
  customerId String        @map("customer_id") @db.Uuid
  type       ConsentType
  action     ConsentAction
  /// Version of the terms / privacy text the customer agreed to.
  version    String
  source     ConsentSource
  occurredAt DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@index([merchantId, customerId, type, occurredAt])
  @@map("customer_consents")
}

// ───────────────────────────── Loyalty ─────────────────────────────

model LoyaltyProgram {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId      String        @map("merchant_id") @db.Uuid
  nameEn          String        @map("name_en")
  nameAm          String?       @map("name_am")
  termsEn         String?       @map("terms_en")
  termsAm         String?       @map("terms_am")
  stampsRequired  Int           @map("stamps_required")
  cooldownMinutes Int           @default(0) @map("cooldown_minutes")
  status          ProgramStatus @default(DRAFT)
  /// At most one default ACTIVE program per merchant (partial unique index in SQL).
  isDefault       Boolean       @default(false) @map("is_default")
  brandColor      String?       @map("brand_color")
  /// Wallet-card display settings (labels, icon keys). Validated by the application.
  cardDisplay     Json          @default("{}") @map("card_display")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  rewardDefinitions RewardDefinition[]
  memberships       CustomerMembership[]

  @@unique([id, merchantId])
  @@index([merchantId, status])
  @@map("loyalty_programs")
}

model RewardDefinition {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId    String                 @map("merchant_id") @db.Uuid
  programId     String                 @map("program_id") @db.Uuid
  nameEn        String                 @map("name_en")
  nameAm        String?                @map("name_am")
  descriptionEn String?                @map("description_en")
  descriptionAm String?                @map("description_am")
  /// Days an unlocked reward stays redeemable; NULL = never expires.
  validForDays  Int?                   @map("valid_for_days")
  status        RewardDefinitionStatus @default(ACTIVE)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  program LoyaltyProgram @relation(fields: [programId, merchantId], references: [id, merchantId], onDelete: Restrict)

  unlocks RewardUnlock[]

  @@unique([id, merchantId, programId])
  @@index([merchantId, programId, status])
  @@map("reward_definitions")
}

/// One customer in one program. Progress is derived from the ledger, not stored.
model CustomerMembership {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId    String           @map("merchant_id") @db.Uuid
  customerId    String           @map("customer_id") @db.Uuid
  programId     String           @map("program_id") @db.Uuid
  status        MembershipStatus @default(ACTIVE)
  /// SHA-256 of the opaque scan token. The raw token is shown to the customer only.
  tokenHash     String           @unique @map("token_hash")
  joinedAt      DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  deactivatedAt DateTime?        @map("deactivated_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer       @relation(fields: [customerId, merchantId], references: [id, merchantId], onDelete: Restrict)
  program  LoyaltyProgram @relation(fields: [programId, merchantId], references: [id, merchantId], onDelete: Restrict)

  walletPasses     WalletPass[]
  stampEvents      StampEvent[]
  rewardUnlocks    RewardUnlock[]
  redemptionEvents RedemptionEvent[]
  reversalEvents   ReversalEvent[]

  @@unique([customerId, programId])
  @@unique([id, merchantId])
  @@unique([id, merchantId, programId])
  @@index([merchantId, programId, status])
  @@index([merchantId, joinedAt])
  @@map("customer_memberships")
}

model WalletPass {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId        String           @map("merchant_id") @db.Uuid
  membershipId      String           @map("membership_id") @db.Uuid
  provider          WalletProvider
  status            WalletPassStatus @default(PENDING)
  /// Apple serial number / Google loyalty object id.
  providerPassId    String?          @map("provider_pass_id")
  /// SHA-256 of the Apple web-service authentication token.
  authTokenHash     String?          @map("auth_token_hash")
  /// Bumped whenever pass content must be refreshed.
  passVersion       Int              @default(1) @map("pass_version")
  /// The pass_version last confirmed delivered to the provider (pending work = pass_version > this).
  lastSyncedVersion Int              @default(0) @map("last_synced_version")
  /// SHA-256 of this pass's own wallet barcode (derived by HMAC from pass id + version; the barcode
  /// itself is never stored). The scanner accepts it like a card token while the pass is ACTIVE.
  barcodeHash       String?          @unique @map("barcode_hash")
  /// Incremented to revoke the current barcode (lost phone, invalidation).
  barcodeVersion    Int              @default(1) @map("barcode_version")
  syncStatus        WalletSyncStatus @default(PENDING) @map("sync_status")
  lastSyncedAt      DateTime?        @map("last_synced_at") @db.Timestamptz(3)
  /// Sanitized provider error summary; never contains credentials.
  lastError         String?          @map("last_error")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  membership CustomerMembership @relation(fields: [membershipId, merchantId], references: [id, merchantId], onDelete: Restrict)

  appleRegistrations AppleDeviceRegistration[]

  @@unique([provider, providerPassId])
  @@unique([id, merchantId])
  // At most one non-INVALIDATED pass per membership and provider (partial unique index in SQL);
  // an invalidated pass keeps its row for history and a replacement gets a new row and serial.
  @@index([membershipId, provider])
  @@index([merchantId, provider, syncStatus])
  @@map("wallet_passes")
}

/// A device that added an Apple Wallet pass and asked to be told about updates (Apple web service).
model AppleDeviceRegistration {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId              String   @map("merchant_id") @db.Uuid
  walletPassId            String   @map("wallet_pass_id") @db.Uuid
  deviceLibraryIdentifier String   @map("device_library_identifier")
  /// APNs push token for this device and pass. Treated as a secret: never logged.
  pushToken               String   @map("push_token")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  walletPass WalletPass @relation(fields: [walletPassId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([walletPassId, deviceLibraryIdentifier])
  @@index([deviceLibraryIdentifier])
  @@map("apple_device_registrations")
}

// ─────────────────────── Ledger (append-only) ───────────────────────

/// One valid visit = one stamp. Never updated or deleted; corrected by ReversalEvent.
model StampEvent {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId        String   @map("merchant_id") @db.Uuid
  branchId          String   @map("branch_id") @db.Uuid
  programId         String   @map("program_id") @db.Uuid
  membershipId      String   @map("membership_id") @db.Uuid
  staffMembershipId String   @map("staff_membership_id") @db.Uuid
  idempotencyKey    String   @map("idempotency_key")
  /// Safe device metadata only (platform, app version). No personal data.
  deviceMetadata    Json?    @map("device_metadata")
  occurredAt        DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  membership CustomerMembership @relation(fields: [membershipId, merchantId, programId], references: [id, merchantId, programId], onDelete: Restrict)
  branch     Branch             @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)
  staff      StaffMembership    @relation(fields: [staffMembershipId, merchantId], references: [id, merchantId], onDelete: Restrict)

  rewardUnlock RewardUnlock?
  reversal     ReversalEvent?

  @@unique([staffMembershipId, idempotencyKey])
  @@unique([id, merchantId])
  @@index([merchantId, membershipId, occurredAt])
  @@index([merchantId, branchId, occurredAt])
  @@index([merchantId, staffMembershipId, occurredAt])
  @@index([merchantId, occurredAt])
  @@map("stamp_events")
}

/// Records that a membership reached the stamp threshold. Status (available / redeemed /
/// expired / reversed) is derived from redemptions, reversals and expires_at.
model RewardUnlock {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId         String    @map("merchant_id") @db.Uuid
  programId          String    @map("program_id") @db.Uuid
  membershipId       String    @map("membership_id") @db.Uuid
  rewardDefinitionId String    @map("reward_definition_id") @db.Uuid
  triggeringStampId  String    @unique @map("triggering_stamp_id") @db.Uuid
  unlockedAt         DateTime  @default(now()) @map("unlocked_at") @db.Timestamptz(3)
  expiresAt          DateTime? @map("expires_at") @db.Timestamptz(3)

  membership       CustomerMembership @relation(fields: [membershipId, merchantId, programId], references: [id, merchantId, programId], onDelete: Restrict)
  rewardDefinition RewardDefinition   @relation(fields: [rewardDefinitionId, merchantId, programId], references: [id, merchantId, programId], onDelete: Restrict)
  triggeringStamp  StampEvent         @relation(fields: [triggeringStampId, merchantId], references: [id, merchantId], onDelete: Restrict)

  redemptions RedemptionEvent[]

  @@unique([id, merchantId])
  @@unique([triggeringStampId, merchantId])
  @@index([merchantId, membershipId, unlockedAt])
  @@index([merchantId, unlockedAt])
  @@map("reward_unlocks")
}

model RedemptionEvent {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId        String   @map("merchant_id") @db.Uuid
  branchId          String   @map("branch_id") @db.Uuid
  membershipId      String   @map("membership_id") @db.Uuid
  rewardUnlockId    String   @map("reward_unlock_id") @db.Uuid
  staffMembershipId String   @map("staff_membership_id") @db.Uuid
  /// 1 for the first redemption of an unlock; 2+ only after an earlier one was reversed.
  /// UNIQUE(reward_unlock_id, attempt_number) makes concurrent double-redemption impossible.
  attemptNumber     Int      @default(1) @map("attempt_number")
  idempotencyKey    String   @map("idempotency_key")
  deviceMetadata    Json?    @map("device_metadata")
  occurredAt        DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  unlock     RewardUnlock       @relation(fields: [rewardUnlockId, merchantId], references: [id, merchantId], onDelete: Restrict)
  membership CustomerMembership @relation(fields: [membershipId, merchantId], references: [id, merchantId], onDelete: Restrict)
  branch     Branch             @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)
  staff      StaffMembership    @relation(fields: [staffMembershipId, merchantId], references: [id, merchantId], onDelete: Restrict)

  reversal ReversalEvent?

  @@unique([rewardUnlockId, attemptNumber])
  @@unique([staffMembershipId, idempotencyKey])
  @@unique([id, merchantId])
  @@index([merchantId, membershipId, occurredAt])
  @@index([merchantId, branchId, occurredAt])
  @@index([merchantId, occurredAt])
  @@map("redemption_events")
}

/// Compensating event that voids exactly one stamp or one redemption.
model ReversalEvent {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId        String         @map("merchant_id") @db.Uuid
  membershipId      String         @map("membership_id") @db.Uuid
  targetType        ReversalTarget @map("target_type")
  stampEventId      String?        @unique @map("stamp_event_id") @db.Uuid
  redemptionEventId String?        @unique @map("redemption_event_id") @db.Uuid
  reversedByStaffId String         @map("reversed_by_staff_id") @db.Uuid
  reason            String
  idempotencyKey    String         @map("idempotency_key")
  occurredAt        DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)

  membership CustomerMembership @relation(fields: [membershipId, merchantId], references: [id, merchantId], onDelete: Restrict)
  stamp      StampEvent?        @relation(fields: [stampEventId, merchantId], references: [id, merchantId], onDelete: Restrict)
  redemption RedemptionEvent?   @relation(fields: [redemptionEventId, merchantId], references: [id, merchantId], onDelete: Restrict)
  reversedBy StaffMembership    @relation(fields: [reversedByStaffId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([reversedByStaffId, idempotencyKey])
  @@unique([stampEventId, merchantId])
  @@unique([redemptionEventId, merchantId])
  @@index([merchantId, membershipId, occurredAt])
  @@index([merchantId, occurredAt])
  @@map("reversal_events")
}

// ───────────────────────── Platform plumbing ─────────────────────────

model IdempotencyRecord {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId        String   @map("merchant_id") @db.Uuid
  staffMembershipId String   @map("staff_membership_id") @db.Uuid
  operation         String
  key               String
  /// The membership the stored answer is about (if any), so anonymizing a customer can purge it.
  membershipId      String?  @map("membership_id") @db.Uuid
  /// Hash of the canonical request; a reused key with a different body is rejected.
  requestHash       String   @map("request_hash")
  responseStatus    Int      @map("response_status")
  responseBody      Json     @map("response_body")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(3)

  merchant Merchant        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  staff    StaffMembership @relation(fields: [staffMembershipId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([staffMembershipId, operation, key])
  @@index([expiresAt])
  @@index([merchantId, membershipId])
  @@map("idempotency_records")
}

/// Append-only audit history. merchant_id is NULL for platform-level events.
model AuditEvent {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId  String?        @map("merchant_id") @db.Uuid
  branchId    String?        @map("branch_id") @db.Uuid
  actorType   AuditActorType @map("actor_type")
  actorUserId String?        @map("actor_user_id") @db.Uuid
  action      String
  targetType  String?        @map("target_type")
  targetId    String?        @map("target_id")
  requestId   String?        @map("request_id")
  /// Safe metadata only: never passwords, tokens, secrets or unnecessary personal data.
  metadata    Json           @default("{}")
  occurredAt  DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)

  merchant  Merchant?     @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  branch    Branch?       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actorUser PlatformUser? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([merchantId, occurredAt])
  @@index([merchantId, actorUserId, occurredAt])
  @@index([merchantId, action, occurredAt])
  @@index([merchantId, branchId, occurredAt])
  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@map("audit_events")
}

/// A reviewable signal, never a penalty. One row per (indicator, subject, time bucket): re-evaluating the same
/// bucket updates the row instead of duplicating it. Contains ids and counts only, no personal data.
model FraudFlag {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId       String           @map("merchant_id") @db.Uuid
  indicator        FraudIndicator
  subjectType      FraudSubjectType @map("subject_type")
  subjectId        String           @map("subject_id") @db.Uuid
  windowStart      DateTime         @map("window_start") @db.Timestamptz(3)
  windowEnd        DateTime         @map("window_end") @db.Timestamptz(3)
  /// What was measured (a count, or a ratio for HIGH_REVERSAL_RATE) and the limit it exceeded.
  observed         Float
  threshold        Float
  details          Json             @default("{}")
  status           FraudFlagStatus  @default(OPEN)
  reviewedByUserId String?          @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  reviewNote       String?          @map("review_note")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  merchant   Merchant      @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  reviewedBy PlatformUser? @relation(fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@unique([merchantId, indicator, subjectType, subjectId, windowStart])
  @@index([merchantId, status, createdAt(sort: Desc)])
  @@index([merchantId, subjectType, subjectId])
  @@map("fraud_flags")
}

/// Transactional outbox: written in the same transaction as the change that needs it.
model OutboxJob {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId    String?      @map("merchant_id") @db.Uuid
  type          String
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  payload       Json         @default("{}")
  /// Optional: collapses duplicate pending jobs for the same target.
  dedupeKey     String?      @unique @map("dedupe_key")
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  maxAttempts   Int          @default(8) @map("max_attempts")
  nextRunAt     DateTime     @default(now()) @map("next_run_at") @db.Timestamptz(3)
  lockedAt      DateTime?    @map("locked_at") @db.Timestamptz(3)
  lockedBy      String?      @map("locked_by")
  /// Sanitized error summary; never contains credentials.
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(3)

  merchant Merchant? @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@index([status, nextRunAt])
  @@index([merchantId, status])
  @@index([merchantId, type, createdAt])
  @@map("outbox_jobs")
}
