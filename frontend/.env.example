# Copy to .env.development.local (development), .env.test.local (tests) or set real environment variables
# (production). Files named .env* are git-ignored except this one. Placeholders only; never commit real values.

# ── Server-only (never sent to the browser) ──────────────────────────────────────────────────────────────
# Backend base URL including the version prefix.
TC_API_BASE_URL=http://localhost:3000/api/v1
# live = real backend, mock = typed fixtures (not allowed in production).
TC_API_MODE=live
# Seals the session cookie that holds the backend tokens: 32+ random characters (openssl rand -base64 48).
TC_SESSION_SECRET=
# Longest time a browser stays signed in (days). Keep at or below the backend refresh-token lifetime (30).
TC_SESSION_MAX_AGE_DAYS=30
# Backend request timeout in milliseconds.
TC_API_TIMEOUT_MS=10000

# ── Public (inlined into browser JavaScript: no secrets here, ever) ──────────────────────────────────────
# Public origin of this frontend.
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Where customers can get help (https page or mailto: address). Optional.
NEXT_PUBLIC_SUPPORT_URL=
